# Database configuration
DB_HOST=127.0.0.1
DB_NAME=epss_v300
DB_USER=epss_user
DB_PASS=StrongPassword123!

# Enterprise backup/restore staging account.
# Recommended: a dedicated MySQL/MariaDB account with CREATE/DROP DATABASE
# and GRANT privileges. If omitted, CAS falls back to DB_USER/DB_PASS and
# fails safely if that account cannot create isolated staging databases.
DB_ADMIN_USER=cas_recovery_admin
DB_ADMIN_PASS=ChangeMeRecoveryAdmin!

# Application URL base (use "/" when deploying at domain root)
BASE_URL=/

# Enable verbose error output in development (set to 1)
APP_DEBUG=1
