# Database configuration
DB_HOST=127.0.0.1
DB_NAME=epss_v300
DB_USER=epss_user
DB_PASS=StrongPassword123!

# Enterprise backup/restore maintenance account.
# This account is used only by the recovery subsystem to create/drop isolated
# candidate databases, restore native dumps, and grant the application account
# access after validation. Use a dedicated least-privilege administrative account
# in production rather than the application account.
DB_MAINT_HOST=127.0.0.1
DB_MAINT_PORT=3306
DB_MAINT_USER=cas_recovery
DB_MAINT_PASS=ChangeThisRecoveryPassword!

# Application URL base (use "/" when deploying at domain root)
BASE_URL=/

# Enable verbose error output in development (set to 1)
APP_DEBUG=1
